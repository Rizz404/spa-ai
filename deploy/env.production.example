# Spa AI — production environment template.
# Copy to the server's shared .env (mode 0600, owned by the deploy user).
# Never commit real values. Fill every <...>.

APP_NAME="Spa AI"
APP_ENV=production
APP_KEY=<preserve_the_key_created_by_Laravel_Toolkit>
APP_DEBUG=false
APP_URL=https://<hostname>
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# PostgreSQL 13+ on Plesk; use a dedicated database and user.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=<spa_database>
DB_USERNAME=<spa_database_user>
DB_PASSWORD=<secret>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log

# AI Spa Concierge provider (HTTPS required in production; base URL without /v1).
# Budgets live in config/assistant.php.
LOCAL_LLM_BASE_URL=https://<provider-host>
LOCAL_LLM_API_KEY=<secret>
LOCAL_LLM_MODEL=<model-alias>
ASSISTANT_REASONING_EFFORT=none

# Trust only the actual reverse proxy IP ranges; never use * on a public origin.
TRUSTED_PROXIES=

# Optional narrator speech; leave blank when disabled.
OPENROUTER_API_KEY=
OPENROUTER_TTS_MODEL=
OPENROUTER_TTS_VOICE=

MAIL_FROM_ADDRESS=<spa_email>
MAIL_FROM_NAME="${APP_NAME}"
